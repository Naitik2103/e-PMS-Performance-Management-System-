# Backend environment variables
# Copy this file to .env and fill the values.

DATABASE_URL=postgres://username:password@host:5432/database
DB_SSL=true

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=8h
JWT_EXPIRES_MS=28800000
PREAUTH_EXPIRES_IN_SECONDS=300

PORT=5000

# Demo-only date override for appraisal windows.
# Format: YYYY-MM-DD
# Leave empty to use the actual current date and database cycle dates.

# Override the current evaluation date (affects all period window checks)
# Example: APPRAISAL_TIME_TRAVEL_DATE=2026-04-16
APPRAISAL_TIME_TRAVEL_DATE=

# Override six-month progress review start date
# Example: APPRAISAL_SIX_MONTH_START_DATE=2026-06-01
APPRAISAL_SIX_MONTH_START_DATE=

# Override annual appraisal start date
# Example: APPRAISAL_ANNUAL_START_DATE=2026-10-01
APPRAISAL_ANNUAL_START_DATE=
